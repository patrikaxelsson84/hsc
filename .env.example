# GitHub data repo – create a PRIVATE repo and put players.json / competitions.json there
# Then create a fine-grained PAT with Contents: read and write on that repo only

VITE_GITHUB_TOKEN=github_pat_REPLACE_ME
VITE_GITHUB_OWNER=your-github-username
VITE_GITHUB_REPO=hsc-data

# Optional – default is players.json
# VITE_GITHUB_PLAYERS_PATH=players.json
